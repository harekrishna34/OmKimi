#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/root/OmKi/node_modules/.pnpm/stream-monaco@0.0.49_monaco-editor@0.55.1/node_modules/stream-monaco/node_modules:/root/OmKi/node_modules/.pnpm/stream-monaco@0.0.49_monaco-editor@0.55.1/node_modules:/root/OmKi/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/root/OmKi/node_modules/.pnpm/stream-monaco@0.0.49_monaco-editor@0.55.1/node_modules/stream-monaco/node_modules:/root/OmKi/node_modules/.pnpm/stream-monaco@0.0.49_monaco-editor@0.55.1/node_modules:/root/OmKi/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  --no-warnings "$basedir/../stream-monaco/cli.mjs" "$@"
else
  exec node  --no-warnings "$basedir/../stream-monaco/cli.mjs" "$@"
fi
